# This service addresses a specific issue when QEMU triggers vfio-pci reset for PCI devices
# before attaching them to a VM on Rocky Linux 10 (kernel 6.12) hypervisors.
# The DMESG log reports race condition between vfio-pci driver and pciehp driver as follows.
# The time taken from vfio-pci driver cutting power of PCI devices to reset gets long enough
# for pciehp driver to assume that the device is yanked out of the board and make the path
# inaccessible. Example log:
# vfio-pci 0000:04:00.0: resetting
# pcieport 0000:02:01.0: pciehp: Slot(4012): Link Down/Up ignored
# vfio-pci 0000:04:00.0: reset done
# vfio-pci 0000:04:00.0: Unable to change power state from D0 to D3hot, device inaccessible
# pcieport 0000:02:01.0: pciehp: Slot(4012): Link Down
# pcieport 0000:02:01.0: pciehp: Slot(4012): Card not present
[Unit]
Description=Disable pciehp driver of parent PCI bridge of PCI device {{ disable_pciehp_vendor_id }}:{{ disable_pciehp_product_id }}
Before=docker.service
After=network.target

[Service]
User=root
Type=oneshot
ExecStart={{ script_location }}
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
