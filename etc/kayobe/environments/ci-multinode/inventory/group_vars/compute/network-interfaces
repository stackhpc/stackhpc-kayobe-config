---
###############################################################################
# Network interface definitions for the compute group.

admin_oc_interface: "{{ ansible_facts.default_ipv4.interface }}"

# Linux bridge containing the VXLAN mesh device. Open vSwitch reaches the mesh
# through a veth pair from this bridge, so the host and Neutron both get frames.
vxlan_mesh_interface: br-vxlan

internal_interface: "{{ vxlan_mesh_interface }}.{{ internal_vlan }}"

storage_interface: "{{ vxlan_mesh_interface }}.{{ storage_vlan }}"

tunnel_interface: "{{ vxlan_mesh_interface }}.{{ tunnel_vlan }}"

###############################################################################
# Dummy variable to allow Ansible to accept this file.
workaround_ansible_issue_8743: yes
