switch_config_mlag_nvue:
  - "set interface peerlink bond member {{ cumulus_peerlink_clag.members }}"
  - "{% if cumulus_peerlink_clag.peer_ip is defined %}set interface peerlink.4094 ip address 169.254.0.{{ (cumulus_peerlink_clag.priority / 1000) | int }}/30{% endif %}"
  - "set system global anycast-id {{ cumulus_peerlink_clag.anycast_id }}"
  - "set mlag backup {{ cumulus_peerlink_clag.backup_ip }}"
  - "set mlag peer-ip {% if cumulus_peerlink_clag.peer_ip is defined %}{{ cumulus_peerlink_clag.peer_ip }}{% else %}linklocal{% endif %}"
  - "set mlag priority  {{ cumulus_peerlink_clag.priority }}"
  - set mlag init-delay 10

switch_vlan_vni_map: {}

switch_config_vni_nvue: >-
  {% set result=[] %}
  {% set x=result.append("nv set bridge domain br_default type vlan-aware") %}
  {%- for key, value in switch_vlan_vni_map.items() -%}
  {% set x=result.append("set bridge domain br_default vlan " + key | string + " vni " + value | string) %}
  {%- endfor -%}
  {{ result | to_json }}

switch_svi: {}

switch_vrf_vni_map: {}

switch_config_svi_nvue: >-
  {% set result=[] %}
  {% set x=result.append('nv set evpn route-advertise svi-ip on') %}
  {%- for vrf, parent_dict_item in switch_svi.items() -%}
  {% set x=result.append("set vrf " ~ vrf ~ " evpn enable on") -%}
  {% set x=result.append("set vrf " ~ vrf ~ " evpn vni " ~ switch_vrf_vni_map[vrf] | mandatory("vrf: " ~ vrf ~ " not in switch_vrf_vni_map") ) %}
  {% set x=result.append("set vrf " ~ vrf ~ " router bgp address-family ipv4-unicast enable on") %}
  {% set x=result.append("set vrf " ~ vrf ~ " router bgp address-family ipv4-unicast redistribute connected enable on") %}
  {% set x=result.append("set vrf " ~ vrf ~ " router bgp address-family l2vpn-evpn enable on") %}
  {% set x=result.append("set vrf " ~ vrf ~ " router bgp autonomous-system "  ~ switch_routing_bgp_asn) %}
  {% set x=result.append("set vrf " ~ vrf ~ " router bgp enable on") %}
  {% set x=result.append("set vrf " ~ vrf ~ " router bgp router-id " ~ switch_routing_bgp_router_id ) %}
  {% for vlan, nested_value in parent_dict_item.items() -%}
  {%- if nested_value['host'] is not defined or nested_value['host'] in ['all', inventory_hostname] -%}
  {%- if nested_value['ip'] is defined -%}
  {% set x=result.append("set interface vlan" + vlan | string + " ip address " + nested_value['ip'] | string) %}
  {%- endif -%}
  {%- if nested_value['vrr'] is defined -%}
  {% set x=result.append("set interface vlan" + vlan | string + " ip vrr address " + nested_value['vrr'] | string) %}
  {%- endif -%}
  {%- if nested_value['vrr_mac'] is defined -%}
  {% set x=result.append("set interface vlan" + vlan | string + " ip vrr mac-address " + nested_value['vrr_mac'] | string) %}
  {%- endif -%}
  {% set x=result.append("set interface vlan" + vlan | string + " ip vrr state up") %}
  {% set x=result.append("set interface vlan" + vlan | string + " ip vrf " + vrf | string) %}
  {%- endif -%}
  {% if switch_pim_enabled | bool %}
  {% set x=result.append("set interface vlan" + vlan | string + " router pim") %}
  {% set x=result.append("set interface vlan" + vlan | string + " ip igmp") %}
  {% endif %}
  {% if switch_pim_enabled | bool %}
  {% set vni=switch_vlan_vni_map[vlan] | default('UNKNOWN') %}
  {% set x=result.append("set bridge domain br_default vlan " + vlan | string + " vni " + vni | string + ' flooding enable on') %}
  {% set x=result.append("set bridge domain br_default vlan " + vlan | string + " vni " + vni | string + ' flooding multicast-group ' + switch_flooding_multicast_group_map[vlan] | mandatory('vlan %s not in switch_flooding_multicast_group_map' % vlan) ) %}
  {% endif %}
  {%- endfor -%}
  {%- endfor -%}
  {{ result | to_json }}

