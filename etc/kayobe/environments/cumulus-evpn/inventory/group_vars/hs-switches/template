switch_config_extra_leaf_nvue: "{{ switch_config_roce_nvue + (switch_config_mlag_nvue if cumulus_peerlink_clag is defined else []) + switch_config_vni_nvue | from_json }}"
switch_config_extra_nclu: "{{ switch_config_routing_nclu + switch_config_bgp_nclu + switch_config_snmp_nclu + switch_config_roce_nclu }}"
switch_config_extra_nvue: "{{ switch_config_routing_nvue + switch_config_bgp_nvue + switch_config_snmp_nvue + (switch_config_extra_leaf_nvue | default([]) if switch_role == 'leaf' else []) }}"

switch_config_snmp_nclu:
  - add snmp-server readonly-community neteng access any
  - "add snmp-server listening-address {{ ansible_host }} vrf mgmt"
  - add snmp-server viewname systemonly included .1.3.6.1.4.1.40310.1
  - add snmp-server viewname systemonly included .1.3.6.1.4.1.40310.2
  - add snmp-server viewname systemonly included .1.3.6.1.4.1.2021.4
  - add snmp-server viewname systemonly included .1.3.6.1.4.1.2021.11

switch_config_snmp_nvue:
  - set system snmp-server state enabled
  - set system snmp-server listening-address {{ ansible_host }}

switch_config_bgp_nclu: "{{ switch_config_bgp_default_nclu + switch_config_bgp_neighbors_nclu | from_json + switch_config_bgp_vrfs_nclu | from_json }}"
switch_config_bgp_nvue: "{{ switch_config_bgp_default_nvue + switch_config_bgp_neighbors_nvue | from_json + switch_config_bgp_vrfs_nvue | from_json }}"
switch_config_bgp_default_nclu:
  - add bgp autonomous-system {{ switch_routing_bgp_asn }}
  - add bgp router-id {{ switch_routing_bgp_router_id }}
  - "{% if switch_role != 'spine' | default(True) %}add bgp bestpath as-path multipath-relax{% endif %}"
  - add bgp neighbor underlay peer-group
  - add bgp neighbor underlay remote-as external
  - "{% if switch_role != 'spine' | default(True) %}add bgp neighbor underlay bfd{% endif %}"
  - "add bgp ipv4 unicast redistribute connected {% if switch_role != 'spine' | default(True) %}route-map CONNECTED_V4{% endif %}"
  - "{% if switch_role != 'spine' | default(True) %}add bgp l2vpn evpn  neighbor underlay activate{% endif %}"
  - "{% if switch_role != 'spine' | default(True) %}add bgp l2vpn evpn  advertise-all-vni{% endif %}"

switch_evpn_multihoming_enabled: true

switch_config_bgp_default_nvue:
  - set router bgp autonomous-system {{ switch_routing_bgp_asn }}
  - set router bgp router-id {{ switch_routing_bgp_router_id }}
  - set router bgp graceful-restart mode helper-only
  - set router vrr enable on
  # NOT in reference config
  #- "{% if switch_role != 'spine' %}set vrf default router bgp path-selection multipath aspath-ignore on{% endif %}"
  - set vrf default router bgp peer-group underlay remote-as external
  - set vrf default router bgp peer-group underlay address-family l2vpn-evpn enable on
  - "{% if switch_role != 'spine' %}set vrf default router bgp peer-group underlay bfd{% endif %}"
  - set vrf default router bgp peer-group underlay bfd detect-multiplier 3
  - set vrf default router bgp peer-group underlay bfd enable on
  - set vrf default router bgp peer-group underlay bfd min-rx-interval 300
  - set vrf default router bgp peer-group underlay bfd min-tx-interval 300
  # TODO: Not needed as set globally
  - set vrf default router bgp router-id {{ switch_routing_bgp_router_id }}
  # TODO: Not needed as set globally
  - set vrf default router bgp autonomous-system {{ switch_routing_bgp_asn }}
  - set vrf default router bgp address-family ipv4-unicast redistribute connected
  - set vrf default router bgp address-family l2vpn-evpn enable on
  - set nve vxlan source address {{ switch_routing_bgp_router_id }}
  - set nve vxlan arp-nd-suppress on
  - set evpn enable on
  - "{% if switch_evpn_multihoming_enabled | bool %}set evpn multihoming enable on{%endif%}"
  - "{% if switch_evpn_multihoming_enabled | bool %}set evpn multihoming startup-delay 10{%endif%}"
  - "{% if switch_pim_enabled | bool%}set router pim enable{%endif%}"
  - "{% if switch_pim_enabled | bool%}set router pim timers keepalive 3600{%endif%}"
  # FIXME: hardcoded
  - "{% if switch_pim_enabled | bool%}set vrf default router pim address-family ipv4 rp 10.10.100.100 group-range 224.1.1.0/24{%endif%}"
  - "{% if switch_pim_enabled | bool%}set vrf default router pim ecmp enable on{%endif%}"

switch_routing_bgp_neighbors: {}

switch_config_bgp_neighbors_nclu: >-
  {% set result=[] %}
  {%- for key, value in switch_routing_bgp_neighbors.items() -%}
  {%- for val in value -%}
  {% set x=result.append("add bgp neighbor " + key + " " + val | string) %}
  {%- endfor -%}
  {%- endfor -%}
  {{ result | to_json }}

switch_config_bgp_neighbors_nvue: >-
  {% set result=[] %}
  {%- for key, value in switch_routing_bgp_neighbors.items() -%}
  {% set x=result.append("set interface " + key + " link state up") %}
  {% set x=result.append("set interface " + key + " type swp") %}
  {%- if switch_evpn_multihoming_enabled | bool -%}
  {% set x=result.append("set interface " + key + " evpn multihoming uplink on") %}
  {%- endif -%}
  {%- if switch_pim_enabled | bool %}
  {% set x=result.append("set interface " + key + " router pim enable on") %}
  {%- endif -%}
  {%- for val in value -%}
  {% set x=result.append("set vrf default router bgp neighbor " + key + " " + val | string) %}
  {%- endfor -%}
  {%- endfor -%}
  {{ result | to_json }}

