switch_aaa_config_nvue:
  - set system aaa class nvapply action allow
  - set system aaa class nvapply command-path / permission all
  - set system aaa class nvshow action allow
  - set system aaa class nvshow command-path / permission ro
  - set system aaa class sudo action allow
  - set system aaa class sudo command-path / permission all
  - set system aaa role nvue-admin class nvapply
  - set system aaa role nvue-monitor class nvshow
  - set system aaa role system-admin class nvapply
  - set system aaa role system-admin class sudo
  - set system aaa user cumulus full-name cumulus
  - set system aaa user cumulus role system-admin
  - set system aaa user cumulus hashed-password '{{ switch_cumulus_user_password | password_hash('sha512') }}'

switch_system_config_nvue:
  - set system api state enabled
  - set system config auto-save state enabled
  - set system control-plane acl acl-default-dos inbound
  - set system control-plane acl acl-default-whitelist inbound
  - set system reboot mode cold
  - set system security password-hardening expiration -1
  - set system security password-hardening expiration-warning -1
  - set system ssh-server state enabled
  - set system wjh channel forwarding trigger l2
  - set system wjh channel forwarding trigger l3
  - set system wjh channel forwarding trigger tunnel
  - set system wjh enable on
  - "{% if switch_anycast_mac is defined %}set system global anycast-mac {{ switch_anycast_mac }}{% endif %}"

switch_hostname_config_nclu:
  - "add hostname {{ switch_hostname }}"

switch_hostname_config_nvue:
  - "set system hostname {{ switch_hostname }}"
  - "set interface eth0 type eth"
  - "set interface eth0 ip vrf mgmt"
  - "set interface eth0 ip address {{ ansible_host }}/24"
  - "{% if switch_mgmt_gateway %}set interface eth0 ip gateway {{ switch_mgmt_gateway }}{% endif %}"

switch_dns_config_nclu: >-
  {% set result=[] %}
  {%- for value in switch_dns_servers -%}
  {% set x=result.append("add dns nameserver ipv4 " + value | string + " vrf mgmt") %}
  {%- endfor -%}
  {{ result | to_json }}

switch_dns_config_nvue: >-
  {% set result=[] %}
  {%- for value in switch_dns_servers -%}
  {% set x=result.append("set service dns mgmt server " + value | string) %}
  {%- endfor -%}
  {{ result | to_json }}

switch_loopback_config_nclu:
  - "{% if cumulus_vxlan_anycast_ip is defined %}add loopback lo clag vxlan-anycast-ip {{ cumulus_vxlan_anycast_ip }}{% endif %}"
  - "{% if cumulus_vxlan_local_tunnel_ip is defined %}add loopback lo vxlan local-tunnelip {{ cumulus_vxlan_local_tunnel_ip }}{% endif %}"
  - "{% if cumulus_loopback_ip is defined %}add loopback lo ip address {{ cumulus_loopback_ip }}{% endif %}"

switch_loopback_config_nvue:
  - "{% if cumulus_vxlan_anycast_ip is defined %}set nve vxlan mlag shared-address {{ cumulus_vxlan_anycast_ip }}{% endif %}"
  - "{% if cumulus_vxlan_local_tunnel_ip is defined %}set nve vxlan source address {{ cumulus_vxlan_local_tunnel_ip }}{% endif %}"
  - "{% if cumulus_loopback_ip is defined %}set interface lo ip address {{ cumulus_loopback_ip }}{% endif %}"
  - "{% if switch_pim_enabled | bool %}set interface lo router pim enable on{% endif %}"
  - "{% if switch_pim_enabled | bool %}set interface lo router pim address-family ipv4-unicast use-source {{ cumulus_loopback_ip | ansible.utils.ipv4('address') }}{% endif %}"

switch_ntp_config_nclu:
  - add time zone {{ switch_timezone | default('UTC') }}
  - del time ntp server 0.cumulusnetworks.pool.ntp.org
  - del time ntp server 1.cumulusnetworks.pool.ntp.org
  - del time ntp server 2.cumulusnetworks.pool.ntp.org
  - del time ntp server 3.cumulusnetworks.pool.ntp.org
  - "{% for ntp_server in switch_ntp_servers | default([]) %}add time ntp server {{ ntp_server }} iburst{% if not loop.last %} {% endif %}{% endfor %}"
  - add time ntp source {{ switch_ntp_source | default('eth0') }}

switch_ntp_config_nvue_static:
  - set system timezone {{ switch_timezone | default('UTC') }}
  - unset service ntp default
  - set service ntp mgmt listen {{ switch_ntp_source | default('eth0') }}

switch_ntp_config_nvue_dynamic: >-
  {% set result=[] %}
  {%- for ntp_server in switch_ntp_servers -%}
  {% set x=result.append("set service ntp mgmt server " ~  ntp_server | string ~ " iburst on") %}
  {%- endfor -%}
  {{ result }}

switch_ntp_config_nvue: "{{ switch_ntp_config_nvue_static + switch_ntp_config_nvue_dynamic }}"

switch_vrf_mgmt_config_nclu:
  - add vrf mgmt ip address 127.0.0.1/8
  - add vrf mgmt ipv6 address ::1/128
  - add vrf mgmt vrf-table auto

switch_vrf_mgmt_config_nvue: []

switch_pim_enabled: true

switch_flooding_multicast_group_map: {}

switch_config_svi_nvue: >-
  {% set result=[] %}
  {%- for key, value in switch_svi.items() -%}
  {% set x=result.append("set vlan" + key | string " domain br_default vlan " + key | string + " vni " + value | string) %}
  {% if switch_pim_enabled | bool %}
  {% set x=result.append("set bridge domain br_default vlan " + key | string + " vni " + value | string  + ' flooding enable on') %}
  {% set x=result.append("set bridge domain br_default vlan " + key | string + " vni " + value | string + 'flooding multicast-group ' + switch_flooding_mulicast_group_map[key]) %}
  {% endif %}
  {%- endfor -%}
  {{ result | to_json }}

# Additional ,,macros''
bond_lacp_bypass: "{% if switch_type == 'nclu' %}{% elif switch_type == 'nvue' %}bond lacp-bypass on{% endif %}"
bond_members: "bond {% if switch_type == 'nclu' %}slaves{% elif switch_type == 'nvue' %}member{% endif %}"
bond_mlag_id: "{% if switch_type == 'nclu' %}clag{% elif switch_type == 'nvue' %}bond mlag{% endif %} id"
bridge_access: "bridge {% if switch_type == 'nclu' %}access{% elif switch_type == 'nvue' %}domain br_default access{% endif %}"
bridge_trunk: "bridge {% if switch_type == 'nclu' %}vids{% elif switch_type == 'nvue' %}domain br_default vlan{% endif %}"
bridge_trunk_native: "bridge {% if switch_type == 'nclu' %}pvid{% elif switch_type == 'nvue' %}domain br_default untagged{% endif %}"

switch_peerlink_config_nclu:
  - clag backup-ip {{ cumulus_peerlink_clag.backup_ip }}
  - clag peer-ip {{ cumulus_peerlink_clag.peer_ip }}
  - clag priority {{ cumulus_peerlink_clag.priority }}
  - clag sys-mac {{ cumulus_peerlink_clag.sysmac }}

switch_interface_config: "{{ (switch_interface_config_shared | default({})) | combine(switch_interface_config_shared_svi | default({})) | combine(switch_interface_config_local | default({})) }}"

switch_config_multihome_bond_access_mode_template: |-
 - bond member %(bond_member)s
 - bridge domain br_default access %(access_vlan)s
 - evpn multihoming segment local-id %(local_id)s
 - bond lacp-bypass on
 - bond mode lacp
 - bridge domain br_default stp admin-edge on
 - bridge domain br_default stp auto-edge on
 - bridge domain br_default stp bpdu-guard on
 - evpn multihoming segment df-preference 50000
 - evpn multihoming segment enable on
 - evpn multihoming segment mac-address {{ switch_anycast_mac }}
 - link mtu 9216