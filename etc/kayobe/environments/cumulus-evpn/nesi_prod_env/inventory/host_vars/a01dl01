# Switch configuration for a01dl01

# This switch is a Cumulus SN3700M

###############################################################################
# Switch credentials.

# Host/IP on which to access the switch via SSH.
ansible_host: 10.110.115.51
switch_hostname: a01dl01
switch_type: nclu
switch_role: leaf

cumulus_peerlink_clag:
  backup_ip: 10.1.1.2
  peer_ip: linklocal
  priority: 1000
  sysmac: 44:38:39:FF:00:01
cumulus_loopback_ip: 10.1.1.1/32
cumulus_vxlan_anycast_ip: 10.1.1.101
cumulus_vxlan_local_tunnel_ip: 10.1.1.1

switch_routing_bgp_asn: 65001
switch_routing_bgp_router_id: 10.1.1.1

switch_routing_bgp_vrfs:
  VRF_1:
    - autonomous-system {{ switch_routing_bgp_asn }}
    - router-id {{ switch_routing_bgp_router_id }}
    - bestpath as-path multipath-relax
    - neighbor 210.7.37.113 remote-as 38022
    - neighbor 210.7.37.113 bfd 3 1000 1000
    - neighbor vlan999 interface remote-as internal
    - ipv4 unicast neighbor 210.7.37.113 route-map POLICY-OUT-1000 out
    - ipv4 unicast redistribute connected
    - l2vpn evpn advertise ipv4 unicast
    - l2vpn evpn default-originate ipv4
  VRF_2:
    - autonomous-system {{ switch_routing_bgp_asn }}
    - router-id  {{ switch_routing_bgp_router_id }}
    - bestpath as-path multipath-relax
    - neighbor 10.255.29.17 remote-as 65029
    - neighbor 10.255.29.17 bfd 3 1000 1000
    - neighbor vlan998 interface remote-as internal
    - ipv4 unicast neighbor 10.255.29.17 route-map POLICY-OUT-1001 out
    - ipv4 unicast redistribute connected
    - ipv4 unicast aggregate-address 10.29.0.0/16
    - l2vpn evpn advertise ipv4 unicast
    - l2vpn evpn default-originate ipv4

switch_routing_bgp_neighbors:
  swp23:
    - "interface peer-group underlay"
  swp24:
   - "interface peer-group underlay"
  swp25:
   - "interface peer-group underlay"
  swp26:
   - "interface peer-group underlay"
  swp27:
   - "interface peer-group underlay"
  swp28:
   - "interface peer-group underlay"
  swp29:
   - "interface peer-group underlay"
  swp30:
   - "interface peer-group underlay"
  peerlink.4094:
   - "interface remote-as internal"

switch_routing_prefix_lists:
  ALLOW-PUB-IP-1000:
    - "seq 5 permit 163.7.144.0/21" #seqs should really be 10s but don't want to risk a routing outage now
  ALLOW-PUB-IP-1001:
    - "seq 10 permit 10.29.0.0/16"

switch_routing_route_maps:
  CONNECTED_V4:
    - "permit 10 match interface lo"
  POLICY-OUT-1000:
    - "permit 10 match ip address prefix-list ALLOW-PUB-IP-1000"
  POLICY-OUT-1001:
    - "permit 10 match ip address prefix-list ALLOW-PUB-IP-1001"
    - "permit 10 set as-path prepend 65001 65001 65001"

switch_routing_vrfs:
  VRF_1:
    - "vni 3004002"
  VRF_2:
    - "vni 3004003"

