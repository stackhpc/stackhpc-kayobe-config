---
switch_routing_bgp_vrfs:
  VRF_1:
    - autonomous-system {{ switch_routing_bgp_asn }}
    - router-id {{ switch_routing_bgp_router_id }}
    - address-family ipv4-unicast redistribute connected enable on
    - address-family ipv4-unicast route-export to-evpn
  VRF_2:
    - autonomous-system {{ switch_routing_bgp_asn }}
    - router-id  {{ switch_routing_bgp_router_id }}
    - address-family ipv4-unicast redistribute connected enable on
    - address-family ipv4-unicast route-export to-evpn

switch_routing_vrfs:
  VRF_1:
    - "vni 3004002"
    - "vlan 4002"
  VRF_2:
    - "vni 3004003"
    - "vlan 4003"

