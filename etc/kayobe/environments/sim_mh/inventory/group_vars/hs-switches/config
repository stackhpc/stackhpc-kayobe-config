---
switch_hostname: "{{ inventory_hostname }}"

switch_dns_servers:
  - "1.1.1.1"
  - "8.8.8.8"

switch_timezone: "Etc/UTC"
switch_ntp_servers:
  - 0.cumulusnetworks.pool.ntp.org
  - 1.cumulusnetworks.pool.ntp.org
  - 2.cumulusnetworks.pool.ntp.org
  - 3.cumulusnetworks.pool.ntp.org

switch_cumulus_user_password: "{{ ansible_ssh_password }}"

external_vlans: ""
ironic_tenant_vlans: ""
sriov_vlans: ""

switch_interface_config_controller_vlans:
  - "{{ internal_net_name | net_vlan }}"
  - "{{ storage_net_name | net_vlan }}"
  - "{{ tunnel_net_name | net_vlan }}"
  - "{{ octavia_net_vlan | default('') }}"
  - "{{ public_net_name | net_vlan }}"
  - "{{ external_vlans }}"
  - "{{ ironic_tenant_vlans }}"
  - "{{ sriov_vlans }}"

switch_interface_config_controller_vlans_csv: "{{ switch_interface_config_controller_vlans config_storage_vlans | unique | select | join(',') }}"

switch_interface_config_storage_vlans:
 - "{{ internal_net_name | net_vlan }}"
 - "{{ storage_net_name | net_vlan }}"
 - "{{ storage_mgmt_net_name | net_vlan }}"

switch_interface_config_storage_vlans_csv: "{{ switch_interface_config_storage_vlans | unique | select | join(',') }}"

switch_interface_config_compute_vlans:
 - "{{ internal_net_name | net_vlan }}"
 - "{{ storage_net_name | net_vlan }}"
 - "{{ storage_mgmt_net_name | net_vlan }}"
 - "{{ tunnel_net_name  | net_vlan }}"
 - "{{ octavia_net_vlan | default('') }}"
 - "{{ external_vlans }}"
 - "{{ ironic_tenant_vlans }}"
 - "{{ sriov_vlans }}"

switch_interface_config_compute_vlans_csv: "{{ switch_interface_config_compute_vlans | unique | select | join(',') }}"

# vlan -> vni
switch_vlan_vni_map:
   10: 10
   20: 20
   30: 30

# vrf name in switch_svi -> vni
switch_vrf_vni_map:
  "RED": 4001
  "BLUE": 4002

switch_mgmt_gateway: "192.168.200.1"

# vlan -> flooding multicast group
switch_flooding_multicast_group_map:
  10: 224.1.1.10
  20: 224.1.1.20
  30: 224.1.1.30

switch_config_pim_rp: 10.10.100.100
switch_config_pim_rp_group_range: "224.1.1.0/24"

switch_svi:
  RED:
    10:
      vrr: "10.1.10.1/24"
      ip: "{{ vlan10_ip }}"
      vrr_mac: "00:00:00:00:00:10"
    20:
      vrr: "10.1.20.1/24"
      ip: "{{ vlan20_ip }}"
      vrr_mac: "00:00:00:00:00:20"
  BLUE:
    30:
      vrr: "10.1.30.1/24"
      ip: "{{ vlan30_ip }}"
      vrr_mac: "00:00:00:00:00:30"

