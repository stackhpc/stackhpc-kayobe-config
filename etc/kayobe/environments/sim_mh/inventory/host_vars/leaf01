# Switch configuration for a01dl01

# This switch is a Cumulus 4610-54T-O-AC-B

###############################################################################
# Switch credentials.

switch_type: nvue
switch_role: leaf

#cumulus_loopback_ip: "{{ switch_routing_bgp_router_id }}/32"
cumulus_loopback_ip: 10.10.10.1/32
switch_routing_bgp_router_id: 10.10.10.1

#TODO:
switch_anycast_mac: "44:38:39:BE:EF:AA"

switch_routing_bgp_asn: 65101

vlan10_ip: 10.1.10.2/24
vlan20_ip: 10.1.20.2/24
vlan30_ip: 10.1.30.2/24


# To spine
switch_routing_bgp_neighbors:
  swp51-54:
    - "peer-group underlay"

switch_interface_config_local:
  bond1:
    config:
      - bond member swp1
  bond2:
    config:
      - bond member swp2
  bond3:
    config:
      - bond member swp3
  swp51-54:
    config:
      - "link state up"
      - "evpn multihoming uplink on"
      - "type swp"
      - "router pim enable on"
