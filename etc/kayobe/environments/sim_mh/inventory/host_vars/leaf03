# Switch configuration for a01dl01

# This switch is a Cumulus 4610-54T-O-AC-B

###############################################################################
# Switch credentials.

switch_type: nvue
switch_role: leaf

cumulus_loopback_ip: 10.10.10.3/32
switch_routing_bgp_router_id: 10.10.10.3

#TODO:
switch_anycast_mac: "44:38:39:BE:EF:BB"

switch_routing_bgp_asn: 65103

vlan10_ip: 10.1.10.4/24
vlan20_ip: 10.1.20.4/24
vlan30_ip: 10.1.30.4/24

# To spine
switch_routing_bgp_neighbors:
  swp51-54:
    - "peer-group underlay"

switch_interface_config_local:
  bond1:
    config: "{{ (switch_config_multihome_bond_hybrid_template % {'bond_member': 'swp2', 'pvid': '10', 'vlans': switch_interface_config_controller_vlans_csv , 'local_id': 1}) | from_yaml }}"
  bond2:
    config: "{{ (switch_config_multihome_bond_hybrid_template % {'bond_member': 'swp2', 'pvid': '20', 'vlans': switch_interface_config_controller_vlans_csv , 'local_id': 2}) | from_yaml }}"
  bond3:
    config: "{{ (switch_config_multihome_bond_hybrid_template % {'bond_member': 'swp3', 'pvid': '30', 'vlans': switch_interface_config_controller_vlans_csv , 'local_id': 3}) | from_yaml }}"