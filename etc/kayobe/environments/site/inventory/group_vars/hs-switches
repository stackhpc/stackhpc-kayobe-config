switch_config_mclag:
  - "interface PortChannel {{ switch_mclag_port_channel }}"
  - ' description "MCLAG PortChannel"'
  - " mtu {{ switch_fabric_mtu }}"
  - "interface {{ switch_mclag_interface_1 }}"
  - " description MCLAG"
  - " channel-group {{ switch_mclag_port_channel }}"
  - " no shutdown"
  - "interface {{ switch_mclag_interface_2 }}"
  - " description MCLAG"
  - " channel-group {{ switch_mclag_port_channel }}"
  - " no shutdown"
  - "mclag domain {{ switch_mclag_domain_id }}"
  - " peer-link PortChannel {{ switch_mclag_port_channel }}"
  - " source-ip {{ switch_mclag_source_ip }}"
  - " peer-ip {{ switch_mclag_peer_ip }}"
  - " mclag-system-mac {{ switch_mclag_system_mac }}"


switch_config_portchannel_fwddecl_template: |-
  {% set result = [] %}
  {%- for intf in switch_interface_config_bonds.keys() -%}
  {% set _ = result.append('interface ' ~ intf) %}
  {% set _ = result.append('exit') %}
  {%- endfor -%}
  {{ result }}

switch_config_portchannel_fwddecl: "{{ switch_config_portchannel_fwddecl_template | from_yaml }}"
