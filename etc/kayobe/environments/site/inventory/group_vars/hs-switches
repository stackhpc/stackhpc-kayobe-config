---
###############################################################################
# Global configuration.

switch_type: dell-sonic
ansible_connection: "network_cli"
ansible_network_os: "dellemc.enterprise_sonic.sonic"
ansible_command_timeout: 120
ansible_user: "{{ secrets_switch_admin_user }}"
ansible_ssh_pass: "{{ secrets_switch_admin_password }}"
switch_auth_pass: omit

switch_config: "{{ switch_config_nested | flatten }}"

switch_config_nested:
  - "{{ switch_config_hostname }}"
  - "{{ switch_config_lldp }}"
  #TODO: NTP
  # - "{{ switch_config_ntp }}"
  - "{{ switch_config_spanning_tree }}"
  - "{{ switch_config_breakout }}"
  #TODO: PFC
  #- "{{ switch_config_pfc }}"
  - "{{ switch_config_mclag }}"
  - "{{ switch_config_vrf }}"
  - "{{ switch_config_portchannel_fwddecl }}"

switch_interface_config: >-
  {{ switch_interface_config_vlans |
     combine(switch_interface_config_bonds) |
     combine(switch_interface_config_ethernet) }}

switch_fabric_mtu: 9100
switch_clear_vlans: false

# Virtual router
switch_config_vrf: []

###############################################################################
# Interface configuration.

# Interface configuration. Dict mapping switch interface names to configuration
# dicts. Each dict contains a description item and a 'config' item which should
# contain a list of per-interface configuration.
switch_interface_config_ethernet: {}
switch_interface_config_bonds: {}

# Use an additional indirection here to enable parameter expansion
switch_interface_config_vlans_template: |-
  vlan {{ production_internal_net_vlan }}:
    description: Production-Internal-API
    config:
      - no shutdown
      - mtu {{ production_internal_net_mtu }}
  vlan {{ production_storage_net_vlan }}:
    description: Production-Ceph-Storage
    config:
      - no shutdown
      - mtu {{ production_storage_net_mtu }}
  vlan {{ production_storage_mgmt_net_vlan }}:
    description: Production-Ceph-Storage-Management
    config:
      - no shutdown
      - mtu {{ production_storage_mgmt_net_mtu }}
  vlan {{ openchami_tenant_net_vlan }}:
    description: OpenCHAMI-Tenant
    config:
      - no shutdown
      - mtu {{ openchami_tenant_net_mtu }}

# Switches or groups can extend/overwrite the VLAN interface dictionary
switch_interface_config_vlans_template_extra: {}


switch_interface_config_vlans: >-
  {{ (switch_interface_config_vlans_template | from_yaml) |
      combine(switch_interface_config_vlans_template_extra | from_yaml) }}

###############################################################################
# Interface variables and templates.

switch_interface_config_lag_member_base: |
  - no shutdown
  #TODO: PFC
  #- no flow-control rx
  #- no flow-control tx
  #- priority-flow-control mode on

# Member of a port-channel for the high-speed networks
switch_interface_config_host_lag_member_template: |-
  {{ switch_interface_config_lag_member_base }}
  #TODO: There's an ordering issue here. We need to set the MTU on first configure to make it match the port channel, but on subsequent configures it fails because we can't change the MTU once an interface is assigned to a port channel.
  - mtu {{ switch_fabric_mtu }}
  - channel-group %(channel)d

# OpenStack compute hypervisor data interface configuration
switch_interface_config_host_lag_member: "{{ switch_interface_config_host_lag_member_template | from_yaml }}"

# Member of a port-channel for the high-speed fabric links
switch_interface_config_fabric_lag_member_template: |-
  {{ switch_interface_config_lag_member_base }}
  #TODO: There's an ordering issue here. We need to set the MTU on first configure to make it match the port channel, but on subsequent configures it fails because we can't change the MTU once an interface is assigned to a port channel.
  - mtu {{ switch_fabric_mtu }}
  - channel-group %(channel)d

# Fabric interface configuration
switch_interface_config_fabric_lag_member: "{{ switch_interface_config_fabric_lag_member_template | from_yaml }}"

# Bonded Ethernet interface configuration
switch_interface_config_lag_template: |
  - mclag {{ switch_mclag_domain_id }}
  - no shutdown
  - mtu {{ switch_fabric_mtu }}
  - "{{ 'no switchport trunk allowed vlan 1-4093' if switch_clear_vlans else '' }}"
  - "{{ 'no switchport access vlan' if switch_clear_vlans else '' }}"

# Switch fabric MLAG link
switch_interface_config_fabric_hs_template: |-
  {{ switch_interface_config_lag_template }}
  - no switchport access vlan
  - switchport trunk allowed vlan {{ switch_fabric_trunk_hs_vlans | unique | join(',') }}

switch_interface_config_fabric_hs: "{{ switch_interface_config_fabric_hs_template | from_yaml }}"

# Ceph server port channel configuration
switch_interface_config_ceph_hs_template: |-
  {{ switch_interface_config_lag_template }}
  - no switchport access vlan
  - switchport trunk allowed vlan {{ switch_ceph_trunk_hs_vlans | unique | join(',') }}
  - spanning-tree port type edge

switch_interface_config_ceph_hs: "{{ switch_interface_config_ceph_hs_template | from_yaml }}"

switch_interface_config_ceph_mgmt_hs_template: |-
  {{ switch_interface_config_lag_template }}
  - fallback
  - no switchport access vlan
  - switchport trunk allowed vlan {{ switch_ceph_mgmt_trunk_hs_vlans | unique | join(',') }}
  - spanning-tree port type edge

switch_interface_config_ceph_mgmt: "{{ switch_interface_config_ceph_mgmt_hs_template | from_yaml }}"

switch_interface_config_compute_hs_template: |-
  {{ switch_interface_config_lag_template }}
  - switchport trunk allowed vlan {{ switch_compute_trunk_hs_vlans | unique | join(',') }}
  - spanning-tree port type edge

switch_interface_config_compute_hs: "{{ switch_interface_config_compute_hs_template | from_yaml }}"

################################################################################
# Port VLAN memberships

# VLANs to trunk to Ceph nodes on the high-speed interface
switch_ceph_trunk_hs_vlans:
  - "{{ production_internal_net_vlan }}"
  - "{{ production_storage_net_vlan }}"
  - "{{ production_storage_mgmt_net_vlan }}"

# VLANs to trunk to Compute nodes on the high-speed interface
switch_compute_trunk_hs_vlans:
  - "{{ openchami_tenant_net_vlan }}"
  - "{{ production_storage_net_vlan }}"

# VLANs to trunk to Mgmt node on the high-speed interface
switch_ceph_mgmt_trunk_hs_vlans:
  - "{{ production_internal_net_vlan }}"

# VLANs to trunk on fabric links
switch_fabric_trunk_hs_vlans:
  - "{{ production_internal_net_vlan }}"
  - "{{ production_storage_net_vlan }}"
  - "{{ production_storage_mgmt_net_vlan }}"
  - "{{ openchami_tenant_net_vlan }}"

###############################################################################
# Switch global config

# Switch hostname
switch_config_hostname:
  - "hostname {{ inventory_hostname }}"

# Enable Rapid PVST
switch_config_spanning_tree:
  - "spanning-tree mode rapid-pvst"

# LLDP configuration.
switch_config_lldp:
  - "lldp enable"

# Switch management timekeeping
# switch_config_ntp:
